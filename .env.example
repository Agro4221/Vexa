VISION_DEVICE=cpu
VISION_MAX_IMAGE_WIDTH=1920
VISION_ENABLE_TRANSFORMERS_COMPAT_PATCH=true
VISION_AUTONOMOUS=false
VISION_INTERVAL=10
VISION_SAVE_LAST_ONLY=true
VISION_PROMPT=Describe the screen briefly. Mention only visible, relevant facts and avoid guessing.
