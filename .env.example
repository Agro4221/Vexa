# Vexa runtime configuration
# Keep this file free of secrets.

VEXA_LLM_PROVIDER=ollama
VEXA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=45
OLLAMA_AUTO_SELECT_MODEL=true
OLLAMA_MODEL_FALLBACK=
OLLAMA_MODEL_PREFERENCE=
USE_WEB_SEARCH=true
USE_STRUCTURED_OUTPUT=true

VEXA_NAME=Vexa
VEXA_AGE=25
VEXA_BIRTHDAY=04.02.2026
VEXA_STYLE=живая, дерзкая, немного пошлая, но без поведения, создающего риск блокировки платформ

VOICE_MODEL_PATH=v5_ru.pt
VOICE_AUTO_DOWNLOAD=true
VEXA_SPEAKER=baya
VEXA_SAMPLE_RATE=48000
TTS_TIMEOUT=60
TTS_QUEUE_MAX_SIZE=32

STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ru
STT_BEAM_SIZE=5
STT_MAX_SECONDS=10
STT_ENERGY_THRESHOLD=450
STT_NO_SPEECH_PROB=0.6
LOCAL_MIC_ENABLED=false

USE_VISION=true
